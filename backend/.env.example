# Application
NODE_ENV=development
PORT=3001

# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/iptv_db?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT Secrets (generate with: openssl rand -base64 64)
JWT_SECRET="your-jwt-secret-minimum-32-chars-change-in-production"
JWT_REFRESH_SECRET="your-refresh-secret-minimum-32-chars-change-in-production"
STREAM_TOKEN_SECRET="your-stream-token-secret-minimum-32-chars-change-in-production"

# TMDB (optional, for metadata enrichment)
TMDB_API_KEY="your-tmdb-api-key"

# Frontend URL (for CORS)
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# Stream Token TTL (seconds)
STREAM_TOKEN_TTL=14400

# DNS Health Check Interval (cron expression)
DNS_HEALTH_CRON="*/2 * * * *"

# Session Settings
SESSION_TTL_HOURS=1
REFRESH_TOKEN_TTL_DAYS=30

# Admin defaults (change after first run)
ADMIN_EMAIL="admin@iptv.local"
ADMIN_PASSWORD="ChangeMe123!"
