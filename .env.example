# =============================================================================
# IPTV Streaming Platform — Environment Variables
# Copy this file to .env and fill in real values before starting the stack.
#   cp .env.example .env
# =============================================================================

# ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_USER=iptv_user
POSTGRES_PASSWORD=iptv_password
POSTGRES_DB=iptv_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://iptv_user:iptv_password@postgres:5432/iptv_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# ── JWT / Token Secrets ───────────────────────────────────────────────────────
# Generate strong secrets with:  openssl rand -hex 64
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_REFRESH_SECRET=your_refresh_token_secret_change_in_production
STREAM_TOKEN_SECRET=your_stream_token_secret_change_in_production

# ── Application ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3001
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost/api

# ── TMDB (The Movie Database — for metadata / artwork) ────────────────────────
# Get your free API key at https://www.themoviedb.org/settings/api
TMDB_API_KEY=your_tmdb_api_key_here

# ── Admin Credentials (created by seed script) ────────────────────────────────
ADMIN_EMAIL=admin@iptv.local
ADMIN_PASSWORD=Admin@123!

# ── NGINX ─────────────────────────────────────────────────────────────────────
NGINX_HOST=localhost
NGINX_PORT=80
